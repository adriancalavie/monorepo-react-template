{
  "name": "monorepo-react-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r --cache build",
    "check-types": "vp run -r --cache check-types",
    "dev": "vp run -r --parallel dev",
    "lint": "vp lint .",
    "prepare": "is-ci || vp config"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@types/bun": "^1.3.14",
    "eslint-plugin-perfectionist": "^5.10.0",
    "is-ci": "4.1.0",
    "sort-package-json": "4.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod-validation-error": "^5.0.0"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  }
}
